# Contact form — POST /api/contact
#
# If RESEND_API_KEY is set, leads are emailed via the Resend REST API.
# Otherwise they are appended to data/leads.json (local/dev).
# On Vercel that file is ephemeral and often not writable — set Resend for production.

RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@pecuniastudios.com
# Must be a verified Resend domain in production. For testing you can use:
# CONTACT_FROM_EMAIL=PecuniaStudios <onboarding@resend.dev>
CONTACT_FROM_EMAIL=PecuniaStudios <hello@pecuniastudios.com>
